# Патеката /gradovi/ е преименувана во /naseleni-mesta/ — не сите
# населени места се градови (план §5.4). Секој стар URL добива траен
# 301, па врските и веќе индексираните страници не пропаѓаат.
#
# Редот е важен: прво точните патеки, па splat-от. Статусот е изричен
# (Cloudflare Pages инаку фалсификува 302), а „!“ не ни треба — на
# Cloudflare redirect-от важи без оглед на постојна датотека, а старите
# датотеки веќе не се извезуваат.
/gradovi/   /naseleni-mesta/        301
/gradovi    /naseleni-mesta/        301
/gradovi/*  /naseleni-mesta/:splat  301

# /o-proektu/ е преименувана во /za-proektot/ — изразот на македонски
# е „за проектот", а страницата веќе се вика така во навигацијата и во
# патеката на лебедите (план §2). Страницата е една, па нема splat.
/o-proektu/  /za-proektot/  301
/o-proektu   /za-proektot/  301
